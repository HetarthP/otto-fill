{
  "manifest_version": 3,
  "name": "JobFill AI",
  "description": "Privacy-first job application autofill helper.",
  "version": "0.1.0",
  "permissions": ["activeTab", "storage", "scripting"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "JobFill AI",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html"
}
